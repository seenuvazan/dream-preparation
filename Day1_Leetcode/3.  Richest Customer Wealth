class Solution {
    public int maximumWealth(int[][] accounts) {
        int rich = 0;
        for (int[] i : accounts) {
            int sum = 0;
            for (int money : i) {
                sum += money;
            }
            rich = Math.max(rich, sum);
        }
        return rich;
    }
}

/*
Complexity:
 Time:  O(m * n) -> Must check every bank balance across m customers & n banks.
 Space: O(1)     -> Uses only two variables (sum and maxWealth), zero extra arrays.
 */
