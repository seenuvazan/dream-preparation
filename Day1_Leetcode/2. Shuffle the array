class Solution {
    public int[] shuffle(int[] nums, int n) {

        int[] result = new int[2 * n];

        int j = 0;

        for (int i = 0; i < n; i++) {
            result[j] = nums[i];
            j++;

            result[j] = nums[i + n];
            j++;
        }

        return result;
    }
}

/*
Complexity:
 Time:  O(n) -> 1 loop runs n times to place all elements.
 Space: O(n) -> 1 new array of size 2*n to store output.
*/
